# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# Generated by flutter_rust_bridge_codegen. Regenerated by CI on every build so
# a stale checked-in copy can never disagree with the Rust it binds.
lib/src/rust/
rust/src/frb_generated.rs
rust/src/frb_generated.io.rs
rust/src/frb_generated.web.rs

# Cross-compiled native libraries, produced by tool/build_rust.sh.
android/app/src/main/jniLibs/

# Rust
rust/target/
**/*.rs.bk

# Android
android/local.properties
android/key.properties
android/*.jks
android/.gradle/
android/captures/
android/app/release/
*.keystore

# Downloaded model weights, if anyone points the app at the repo during dev.
*.gguf
*.gguf.part
