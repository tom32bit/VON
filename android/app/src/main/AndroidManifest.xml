<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Network access is for two things only: downloading GGUF weights the user
      explicitly asked for, and reaching the cloud provider whose API key the
      user entered. Nothing is sent anywhere on launch.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      A run happens on Rust threads inside this process, which Android knows
      nothing about. Backgrounded, the process becomes a cached one, and a
      cached process holding a 1.7GB mmapped model is the first thing the
      low-memory killer takes — the run simply vanished. A foreground service
      is the only supported way to say "work is still happening"; it is started
      when a run begins and stopped the moment it ends.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ will not show the service's notification without this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Deliberately NOT requested:
        READ/WRITE_EXTERNAL_STORAGE - every project sandbox lives in app-private
          storage; imports come through the system picker, which grants one file
          at a time, and the export flow hands a file to the share sheet.
        WAKE_LOCK - a long agent run should not be able to hold the device awake.
          The foreground service keeps the process alive without keeping the
          screen on, which is the behaviour we actually want.
    -->

    <!-- Local models need real RAM; the profiler is honest about this. -->
    <uses-feature android:name="android.hardware.ram.low" android:required="false" />

    <application
        android:label="VON"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          FlutterActivity was referenced directly for a long time, so the project
          carried no JVM source at all. Keeping a backgrounded run alive needs a
          foreground service, starting one needs a context and a method channel,
          and both need somewhere to live — so there is now exactly one activity
          and one service, and nothing else.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          dataSync rather than a more specific type: the run is doing local
          computation and talking to a model provider, which is the closest
          thing the taxonomy offers. Not exported — only this app starts it.
        -->
        <service
            android:name=".AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Required by share_plus to hand the exported .zip to another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
