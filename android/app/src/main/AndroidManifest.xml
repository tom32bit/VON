<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Network access is for two things only: downloading GGUF weights the user
      explicitly asked for, and reaching the cloud provider whose API key the
      user entered. Nothing is sent anywhere on launch.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Deliberately NOT requested:
        READ/WRITE_EXTERNAL_STORAGE - every project sandbox lives in app-private
          storage; the export flow hands a file to the share sheet instead.
        WAKE_LOCK - a long agent run should not be able to hold the device awake.
        FOREGROUND_SERVICE - runs are user-initiated and bounded (MAX_STEPS).
    -->

    <!-- Local models need real RAM; the profiler is honest about this. -->
    <uses-feature android:name="android.hardware.ram.low" android:required="false" />

    <application
        android:label="VON"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          FlutterActivity is referenced directly rather than subclassed, so the
          project contains no Java or Kotlin source at all (PRD §2). The Rust
          core is loaded by flutter_rust_bridge from jniLibs; nothing here needs
          a JVM-side entry point.
        -->
        <activity
            android:name="io.flutter.embedding.android.FlutterActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Required by share_plus to hand the exported .zip to another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
