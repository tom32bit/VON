<?xml version="1.0" encoding="utf-8"?>
<!--
  The forge mark: a hexagon outline in Twitter Blue.

  Adaptive-icon foregrounds are 108x108dp with only the centre 72x72dp
  guaranteed visible, so the glyph is inset well inside the safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer hexagon -->
    <path
        android:strokeColor="#1DA1F2"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M54,32 L72,42.5 L72,63.5 L54,74 L36,63.5 L36,42.5 Z" />

    <!-- Inner core, filled to give the mark weight at small sizes -->
    <path
        android:fillColor="#1DA1F2"
        android:pathData="M54,44 L63,49.25 L63,59.75 L54,65 L45,59.75 L45,49.25 Z" />
</vector>
