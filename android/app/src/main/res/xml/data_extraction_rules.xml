<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer are disabled outright.

  The database holds the user's cloud API keys in plaintext (protected by
  app-private storage), and model weights are multi-gigabyte files that would be
  pointless to back up. Local-only means local-only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
